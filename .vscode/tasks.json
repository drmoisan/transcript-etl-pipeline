{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Black: format",
      "type": "shell",
      "command": "poetry",
      "args": ["run", "black", "."],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Ruff: lint",
      "type": "shell",
      "command": "poetry",
      "args": ["run", "ruff", "check"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Pyright: type-check",
      "type": "shell",
      "command": "poetry",
      "args": ["run", "pyright"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Pytest: run tests",
      "type": "shell",
      "command": "poetry",
      "args": ["run", "pytest"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run All Checks",
      "dependsOn": [
        "Black: format",
        "Ruff: lint",
        "Pyright: type-check",
        "Pytest: run tests"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Fix All",
      "type": "shell",
      "command": "pwsh",
      "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/fix-all.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
          "reveal": "always",
          "panel": "new"
      }
    },
    {
      "label": "GitHub: New Feature Issue",
      "type": "shell",
      "command": "gh",
      "args": [
        "issue",
        "create",
        "--template",
        "feature-request.md"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Creates a feature issue using .github/ISSUE_TEMPLATE/feature-request.md (requires gh CLI auth)."
    },
    {
      "label": "GitHub: New Bug Issue",
      "type": "shell",
      "command": "gh",
      "args": [
        "issue",
        "create",
        "--template",
        "bug-report.md"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Creates a bug report using .github/ISSUE_TEMPLATE/bug-report.md (requires gh CLI auth)."
    },
        {
            "label": "Feature: New Potential Entry",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/new-potential-entry.ps1",
                "-ShortName",
                "${input:PotentialShortName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "detail": "Creates a dated potential feature file from the template and opens it plus backlog.md for editing."
        }
    ],
    "inputs": [
        {
            "id": "PotentialShortName",
            "type": "promptString",
            "description": "Short name (kebab-case, e.g., notes-feature)",
            "default": "notes-feature"
        }
    ]
}
